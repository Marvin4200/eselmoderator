# --- Discord ---
# Neue, eigene Discord-Anwendung/Bot im Developer Portal anlegen -- eigener Token, nicht
# identisch mit Fahrstuhls Token (siehe Plan: "Was du selbst tun musst").
DISCORD_TOKEN=

# --- MySQL (eigene Datenbank, getrennt von fahrstuhl) ---
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=eselmoderator
MYSQL_PASSWORD=
MYSQL_DATABASE=eselmoderator

# --- Bot-API ---
# Eigener, neuer Zufallswert -- NICHT mit fahrstuhls BOT_API_TOKEN teilen.
BOT_API_TOKEN=
PORT=3003
